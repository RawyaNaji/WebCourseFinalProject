@model RecipeBoard.Models.Recipe
@{
    ViewData["Title"] = "Delete Recipe";
}

<h1>Delete Recipe</h1>

<div class="alert alert-warning">Are you sure you want to delete this recipe?</div>

<dl class="row">
    <dt class="col-sm-2">Title</dt>
    <dd class="col-sm-10">@Model.Title</dd>
    <dt class="col-sm-2">Category</dt>
    <dd class="col-sm-10">@Model.Category.Name</dd>
    <dt class="col-sm-2">Prep Time</dt>
    <dd class="col-sm-10">@Model.PrepTimeMinutes minutes</dd>
</dl>

<form method="post" asp-controller="Recipes" asp-action="Delete" asp-route-id="@Model.RecipeId" onsubmit="return confirmDelete()">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
