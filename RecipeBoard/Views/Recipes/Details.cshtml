@model RecipeBoard.Models.Recipe
@{
    ViewData["Title"] = Model.Title;
}

<h1>@Model.Title</h1>
<p><strong>Category:</strong> @Model.Category.Name</p>
<p><strong>Prep Time:</strong> @Model.PrepTimeMinutes minutes</p>
<p><strong>Instructions:</strong></p>
<p>@Model.Instructions</p>

<a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
@if (Context.Session.GetString("Role") == "Admin")
{
    <a asp-action="Edit" asp-route-id="@Model.RecipeId" class="btn btn-outline-primary">Edit</a>
}
@if (Context.Session.GetString("Username") != null)
{
    if ((bool)ViewBag.IsSaved)
    {
        <form method="post" asp-controller="SavedRecipes" asp-action="Remove" class="d-inline">
            <input type="hidden" name="recipeId" value="@Model.RecipeId" />
            <button type="submit" class="btn btn-outline-danger">Remove from Saved</button>
        </form>
    }
    else
    {
        <form method="post" asp-controller="SavedRecipes" asp-action="Save" class="d-inline">
            <input type="hidden" name="recipeId" value="@Model.RecipeId" />
            <button type="submit" class="btn btn-outline-success">Save Recipe</button>
        </form>
    }
}
